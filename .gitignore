# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.impeccable
.claude

# uploaded event photographs, and the reference selfies used to search them
# STORAGE_ROOT defaults to ./storage, which sits inside the repo — without this
# the first `git add .` after an upload would commit identifiable photographs of
# students. Face data is sensitive personal data under the PDPA, which
# PRODUCT.md records as a legal obligation rather than a preference, and git
# keeps deleted files in history, so a later commit could not undo it.
/storage

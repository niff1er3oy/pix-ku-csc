# ---------------------------------------------------------------------------
# PIX KU CSC — copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Postgres running from docker-compose.yml (host port 5433 to avoid clashing
# with any local Postgres already on 5432).
DATABASE_URL=postgres://findkudae:findkudae@localhost:5433/findkudae

# --- Auth.js -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public origin. Behind Cloudflare Tunnel this must be the tunnel hostname,
# otherwise the Google OAuth callback will not match.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- AWS Rekognition ---------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Prefix for the per-event Rekognition collections this app creates.
REKOGNITION_COLLECTION_PREFIX=findkudae
# Minimum match confidence (0-100) for a face to count as "this is you".
# 90 keeps false positives low; drop to ~85 if real users report missed photos.
FACE_MATCH_THRESHOLD=90

# Set to "mock" to run the whole app without touching AWS (deterministic fake
# matches, useful for UI work). Set to "rekognition" to use the real service.
FACE_PROVIDER=rekognition

# --- Local file storage ------------------------------------------------------
# Originals live outside ./public so they can only be served through the
# authorized route handler at /api/media.
#
# ./storage is a development value. It is relative, so it resolves against the
# process working directory, and it sits inside the repository.
#
# IN PRODUCTION, SET AN ABSOLUTE PATH OUTSIDE THE APPLICATION DIRECTORY —
# /var/lib/findkudae/storage, or a mounted volume. Two reasons, both of which
# lose photographs rather than merely inconvenience someone:
#
#   1. A deployment replaces the application directory. A new release folder, a
#      git checkout, a rebuilt container — anything under it goes with the old
#      copy. This is the same failure the Postgres volume had before the mount
#      path was corrected in docker-compose.yml.
#   2. A relative path follows the working directory. Started from somewhere
#      other than the project root — systemd, pm2, a standalone build — and the
#      photographs quietly land somewhere nobody looks.
#
# The directory holds identifiable photographs of students and the reference
# selfies used to search them, which is sensitive personal data under the PDPA.
# Back it up and restrict its permissions like the database, not like a cache.
STORAGE_ROOT=./storage

# --- App ---------------------------------------------------------------------
# Used to build QR code targets and shareable event links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that get the admin role on first sign-in.
ADMIN_EMAILS=

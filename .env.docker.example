# ---------------------------------------------------------------------------
# PIX KU CSC — settings for docker-compose.prod.yml.
# Copy to .env.docker and fill in. Never commit .env.docker.
# ---------------------------------------------------------------------------

# Which images to run. Leave APP_IMAGE as it is to build on this machine.
# To use the ones GitHub Actions pushes to Docker Hub
# (.github/workflows/docker-image.yml):
#   APP_IMAGE=<your-dockerhub-username>/pix-ku-csc
#   APP_VERSION=master        (or a release such as 1.0.0, or latest)
# and start with --no-build.
APP_IMAGE=pix-ku-csc
APP_VERSION=latest

# The public address people reach the site on — what every QR code points to.
# Behind Cloudflare Tunnel, the tunnel hostname. Also used for Google sign-in,
# so the same URL + /api/auth/callback/google must be an authorised redirect
# URI in the Google Cloud console.
APP_URL=https://pix.example.ku.ac.th

# Port on this machine the site listens on (127.0.0.1 only).
APP_PORT=3313

# --- Database (created on first start) --------------------------------------
POSTGRES_USER=pixku
POSTGRES_DB=pixku
# Long and random. Changing it after the first start does not change the
# password inside the existing database volume.
POSTGRES_PASSWORD=

# --- Sign-in -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated e-mail addresses that become admins on first sign-in.
ADMIN_EMAILS=

# --- Face search -------------------------------------------------------------
# "rekognition" for the real service, "mock" to try the site without AWS.
FACE_PROVIDER=rekognition
FACE_MATCH_THRESHOLD=90
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must differ between installations that share one AWS account, or they will
# create collections with the same names.
REKOGNITION_COLLECTION_PREFIX=findkudae
